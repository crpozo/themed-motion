# Uploaded media only - nothing in here may ever run as code.
<FilesMatch "\.(?i:php\d?|phtml|phar|pht|cgi|pl|py|sh|html?|js|svg)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
